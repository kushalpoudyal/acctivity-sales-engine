OPENAI_API_KEY=
# Default for connectivity, research and file generation.
OPENAI_MODEL=gpt-6.1-sol
# Optional; enables the Apollo panel (firm enrich, contacts, firm search).
APOLLO_API_KEY=
# Optional; enables the "Personalised AI video" output. The campaign (base video + variables) is set up in the
# Sendspark app; SENDSPARK_PROSPECT_EMAIL is a team inbox that gets one plus-address per firm.
SENDSPARK_API_KEY=
SENDSPARK_API_SECRET_KEY=
SENDSPARK_WORKSPACE_ID=
SENDSPARK_DYNAMIC_ID=
SENDSPARK_PROSPECT_EMAIL=
# Optional; demo environment (seeding a rep's Acctivity test firm). Ask the backend team for the values.
# Writes are refused unless DEMO_ENVIRONMENT=test and the firm id is in DEMO_FIRM_ALLOWLIST (comma-separated).
DEMO_ENVIRONMENT=
DEMO_FIRM_ALLOWLIST=
# The rep's demo firm (Acctivity test firm id; must also be in DEMO_FIRM_ALLOWLIST) and its 6 staff alias user ids,
# comma-separated in plan slot order (managing partner first). Optional: parallel seed requests (default 4).
DEMO_FIRM_ID=
DEMO_STAFF_USER_IDS=
DEMO_SEED_CONCURRENCY=
# Each service's /api/ root on the test environment (paths are then v1/...).
ACCTIVITY_API_URL=
ACCTIVITY_MANAGEMENT_API_URL=
ACCTIVITY_DOCSCORE_API_URL=
ACCTIVITY_DEXTER_API_URL=
# Shared service login (client credentials).
ACCTIVITY_SERVICE_CLIENT_ID=
ACCTIVITY_SERVICE_CLIENT_SECRET=
ACCTIVITY_SERVICE_TOKEN_URL=
ACCTIVITY_SERVICE_AUDIENCE=
